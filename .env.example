# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose to browser - RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - NEVER expose to browser - server side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# MalipoPay
# ─────────────────────────────────────────────────────────────────────────────
# API token from MalipoPay dashboard - server side only
MALIPOPAY_API_TOKEN=your-malipopay-api-token

# Base URL for MalipoPay collection API
MALIPOPAY_BASE_URL=https://core-prod.malipopay.co.tz/api/v1

# Optional: webhook secret for verifying MalipoPay callbacks
# (fill in once MalipoPay provides webhook signing documentation)
MALIPOPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Omada Northbound Open API (server-side only)
# OMADA_SITE_ID is the Omada site ID, not the controller/account ID.
OMADA_API_URL=https://euw1-omada-northbound.tplinkcloud.com
OMADA_CLIENT_ID=your-omada-client-id
OMADA_CLIENT_SECRET=your-omada-client-secret
OMADA_OMADAC_ID=aaa4051533227838c9b29aa48a2fa2f2
OMADA_SITE_ID=6a9022acd869a50d314e27cd
OMADA_SITE_NAME=your-omada-site-name
# Omada Controller hotspot API (server-side only)
OMADA_CONTROLLER_URL=https://your-controller-host:8043
OMADA_CONTROLLER_ID=your-controller-id
OMADA_OPERATOR_USERNAME=your-hotspot-operator-username
OMADA_OPERATOR_PASSWORD=your-hotspot-operator-password
# After configuring credentials, GET /api/admin/omada/sites lists available site IDs.

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Public base URL (used for webhook callbacks, redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Secret used to sign portal session tokens (min 32 chars, random)
PORTAL_SESSION_SECRET=replace-with-32-plus-char-random-string

# Secret used to sign admin JWT tokens
ADMIN_JWT_SECRET=replace-with-32-plus-char-random-string

# NextAuth secret
NEXTAUTH_SECRET=replace-with-32-plus-char-random-string
NEXTAUTH_URL=https://your-domain.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (optional Redis URL for distributed rate limiting)
# If not set, in-memory rate limiting is used (not suitable for multi-instance)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Set to "true" to enable mock payment mode (no real STK push)
MOCK_PAYMENTS=false

# Set to "true" to enable mock Omada authorization (no real controller calls)
MOCK_OMADA=false
